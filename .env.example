# Cloud MySQL is required. Clever Cloud supplies these values when the MySQL
# add-on is linked to the application. For local development, provide your
# cloud connection values in .env.
MYSQL_ADDON_HOST=mysql.example.clever-cloud.com
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_DB=your_database
MYSQL_ADDON_USER=your_user
MYSQL_ADDON_PASSWORD=replace-with-a-secret

# Set only when Clever Cloud ProxySQL is enabled. It takes priority over HOST
# and PORT, and is normally supplied by Clever Cloud rather than set manually.
# CC_MYSQL_PROXYSQL_SOCKET_PATH=/path/to/proxysql.sock
